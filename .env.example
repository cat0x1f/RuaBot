# Telegram Bot 配置
BOT_TOKEN=your_bot_token_here
ALLOWED_GROUPS=-1001852815669,-1268145665910
LOG_LEVEL=INFO

# ===== Bluesky → Telegram 转发 =====
# 开关：设置为 true 启用，默认 false
ENABLE_BSKY_TO_TG=false

# 要跟踪的 Bluesky 用户 handle
BSKY_HANDLE=alice.bsky.social

# 轮询间隔（秒），默认 60
BSKY_POLL_INTERVAL=60

# 状态文件路径，默认 /app/data/bsky_state.json
BSKY_STATE_FILE=/app/data/bsky_state.json

# ===== Twitter → Bluesky → Telegram 转发 =====
# 开关：设置为 true 启用，默认 false
ENABLE_TWITTER_TO_BSKY=false

# 要跟踪的 Twitter 用户名（不带 @）
TWITTER_HANDLE=your_twitter_handle

# 用于发帖的 Bluesky 账号
BSKY_POST_HANDLE=your.bsky.social

# Bluesky App Password（在 Settings → Privacy and security → App passwords 生成）
BSKY_POST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 轮询间隔（秒），默认 60
TWITTER_POLL_INTERVAL=60

# 状态文件路径，默认 /app/data/twitter_state.json
TWITTER_STATE_FILE=/app/data/twitter_state.json
